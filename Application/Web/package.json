{
  "name": "panic-web",
  "version": "0.3.0",
  "private": true,
  "description": "PANIC web UI (Vue 3 + Quasar 2). Talks only to Server through allow-listed /api/v1 and /auth paths (AR-1.6).",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "node scripts/gen-api.mjs --check"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.4",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  }
}
