# panic-web: the Vue/Quasar SPA served by nginx as uid 101 (port 8080), proxying only the allow-listed
# server paths (Application/Web/proxy-paths.json, AR-6.4) to PANIC_SERVER_URL, all under PANIC_BASE_PATH.

FROM docker.io/library/node:26-alpine AS spa
WORKDIR /src/Application/Web
COPY Application/Web/package.json Application/Web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY Application/Web ./
RUN npx quasar prepare && npm run build

FROM docker.io/library/python:3.13-alpine AS conf
COPY Application/Web/proxy-paths.json /src/Application/Web/proxy-paths.json
COPY Build/scripts/gen_nginx_conf.py /src/Build/scripts/gen_nginx_conf.py
RUN python /src/Build/scripts/gen_nginx_conf.py --out /default.conf.template

# Official nginx, set up below the way nginx-unprivileged is. 1.30.7 fixes CVE-2026-123007 and CVE-2026-123633
# (HTTP/2); nginx-unprivileged had no 1.30.7 build when this was set, and its 1.29 branch gets no fix.
FROM docker.io/library/nginx:1.30.7-alpine
# Render the template into /tmp (writable on a read-only root fs) and include it from there.
ENV NGINX_ENVSUBST_FILTER=^PANIC_(SERVER_URL|BASE_PATH)$ \
    NGINX_ENVSUBST_OUTPUT_DIR=/tmp
USER root
# Run as uid 101 the way nginx-unprivileged does: no `user` directive, pid and temp files in /tmp.
RUN sed -i -e '/^user /d' -e 's#^pid .*#pid /tmp/nginx.pid;#' \
      -e '/^http {/a\    client_body_temp_path /tmp/client_temp;\n    proxy_temp_path /tmp/proxy_temp;\n    fastcgi_temp_path /tmp/fastcgi_temp;\n    uwsgi_temp_path /tmp/uwsgi_temp;\n    scgi_temp_path /tmp/scgi_temp;' \
      /etc/nginx/nginx.conf \
 && chown -R 101:0 /var/cache/nginx && chmod -R g+w /var/cache/nginx \
 && sed -i 's#include /etc/nginx/conf.d/\*\.conf;#include /tmp/*.conf;#' /etc/nginx/nginx.conf \
 && grep -q 'include /tmp/\*.conf;' /etc/nginx/nginx.conf \
 && rm -f /etc/nginx/conf.d/default.conf
USER 101
COPY --from=spa /src/Application/Web/dist/spa /usr/share/nginx/html
COPY --from=conf /default.conf.template /etc/nginx/templates/default.conf.template
COPY Build/Containers/common/panic-env.sh /usr/local/lib/panic/panic-env.sh
COPY --chmod=0755 Build/Containers/web/10-panic-env.envsh /docker-entrypoint.d/10-panic-env.envsh
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
