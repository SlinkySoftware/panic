#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Sourced by the nginx image entrypoint before templates are rendered: validate the two variables envsubst
# fills in (NGINX_ENVSUBST_FILTER).
#   PANIC_SERVER_URL  must be a bare scheme://host[:port] origin: nginx would otherwise rewrite request paths
#                     (proxy_pass with a URI part).
#   PANIC_BASE_PATH   the URL prefix (empty = /), normalised to '' or /a[/b]: letters, digits, - and _ only, as
#                     panic_server.paths requires (it lands in nginx locations, one of them a regex). Must equal
#                     panic-server's PANIC_BASE_PATH. Always exported, so envsubst never leaves it unfilled.
. /usr/local/lib/panic/panic-env.sh
panic_file_env PANIC_SERVER_URL || exit 1

if [ -z "${PANIC_SERVER_URL:-}" ]; then
    echo "panic-web: PANIC_SERVER_URL is required (e.g. http://panic-server:8210)" >&2
    exit 1
fi
PANIC_SERVER_URL="${PANIC_SERVER_URL%/}"
if ! printf '%s' "$PANIC_SERVER_URL" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$|^https?://\[[0-9A-Fa-f:.]+\](:[0-9]{1,5})?$'; then
    echo "panic-web: PANIC_SERVER_URL must be scheme://host[:port] with no path, got: $PANIC_SERVER_URL" >&2
    exit 1
fi
export PANIC_SERVER_URL

_pb=$(printf '%s' "${PANIC_BASE_PATH:-}" | sed -E 's#/+#/#g; s#^/##; s#/$##')
if [ -n "$_pb" ]; then
    if ! printf '%s' "$_pb" | grep -Eq '^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$'; then
        echo "panic-web: PANIC_BASE_PATH may only contain letters, digits, '-', '_' and '/', got: $PANIC_BASE_PATH" >&2
        exit 1
    fi
    _pb="/$_pb"
fi
PANIC_BASE_PATH="$_pb"
unset _pb
export PANIC_BASE_PATH
