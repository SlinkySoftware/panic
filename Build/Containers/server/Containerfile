# panic-server: the API only (no static files; panic-web serves the SPA). Unprivileged, read-only friendly,
# init on start (indexes, migrate), HEALTHCHECK on /api/v1/health?ready=1 (includes a Mongo ping).
FROM docker.io/library/python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PANIC_SERVER_BIND=0.0.0.0:8210 \
    DJANGO_SETTINGS_MODULE=panic_server.settings

RUN groupadd --system --gid 10001 panic \
 && useradd --system --uid 10001 --gid panic --home-dir /app --shell /usr/sbin/nologin panic

WORKDIR /app
COPY pyproject.toml ./
COPY Application/Common ./Application/Common
COPY Application/Server ./Application/Server
RUN pip install ./Application/Common ./Application/Server

COPY Build/Containers/common/panic-env.sh /usr/local/lib/panic/panic-env.sh
COPY --chmod=0755 Build/Containers/server/entrypoint.sh /usr/local/bin/panic-entrypoint
COPY Build/Containers/server/healthcheck.py /usr/local/lib/panic/healthcheck.py

WORKDIR /app/Application/Server
USER panic:panic
EXPOSE 8210

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["python", "/usr/local/lib/panic/healthcheck.py"]

ENTRYPOINT ["/usr/local/bin/panic-entrypoint"]
CMD ["gunicorn"]
