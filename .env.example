# PANIC Server configuration example (AR-3.1)
# Copy to .env for local overrides. Never commit real secrets or environment hostnames.

PANIC_ENV=dev
PANIC_DEBUG=true
PANIC_DJANGO_SECRET_KEY=change-me-to-a-long-random-string
PANIC_ALLOWED_HOSTS=*
PANIC_SERVER_BIND=0.0.0.0:8120
PANIC_INSTANCE_NAME=PANIC
PANIC_LOG_LEVEL=INFO
PANIC_LOG_FORMAT=json
PANIC_TZ=UTC

# Local bootstrap admin (no relational database left -- everything lives in MongoDB below)
# PANIC_BOOTSTRAP_ADMIN_USER=admin
# PANIC_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/panic_bootstrap_admin_password

# Reverse proxy & Security Zone resolution
PANIC_TRUST_PROXY_HEADERS=true
PANIC_PROXY_IP_HEADER=X-Forwarded-For
PANIC_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# PANIC_UNTRUSTED_PEER_POLICY=default

PANIC_CATALOG_MODERATION_MODE=MODERATED

# MongoDB (Stage 6; see Documents/Architecture/DATA_MODEL.md §2)
# PANIC_MONGO_URI=mongodb://127.0.0.1:27117/panic
# PANIC_ZONE_CACHE_TTL_S=10
# PANIC_AUDIT_RETENTION_DAYS=365
# PANIC_TEST_MONGO_URI=mongodb://127.0.0.1:27117/
