#!/usr/bin/env bash
# PANIC dev control script.
#
#   ./panic setup                         idempotent venv + editable package setup + pinned Node + npm ci + .env
#   ./panic start|stop|restart [server|web|all] [--prod]
#   ./panic status
#   ./panic test [python|web|lint|all] [pytest args...]
#   ./panic logs [server|web]
#   ./panic manage <django manage.py args...>    (loads .env, like start)
#   ./panic addexamples | delexamples             add / remove the example dataset (never touches other data)
#   ./panic promote|demote <username>             grant / remove Global Admin (also: ./panic user promote|demote)
#   ./panic contracts [--check]           regenerate (or, with --check, verify) the committed
#                                          OpenAPI contract, Documents/Architecture/openapi/server.yaml
#
# Overrides:
#   PANIC_WEB_PORT      web dev server port (default 8120)
#   PANIC_WEB_ALLOWED_HOSTS  extra comma-separated hostnames for the web dev server, e.g. .example.com
#                       (this machine's own hostname and FQDN are always allowed)
#   PANIC_SERVER_BIND   Server bind address (default 0.0.0.0:8121)
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$ROOT"

# ---------------------------------------------------------------- pinned toolchain
NODE_VERSION="v26.13.1"

VENV="$ROOT/.venv"
TOOLS="$ROOT/.tools"
RUN="$ROOT/.run"
PIDS="$RUN/pids"
LOGS="$RUN/logs"
SERVER_DIR="$ROOT/Application/Server"
WEB_DIR="$ROOT/Application/Web"
NODE_HOME="$TOOLS/node"
COMPONENTS=(server web)

if [[ -t 1 ]]; then C_OK=$'\e[32m'; C_WARN=$'\e[33m'; C_ERR=$'\e[31m'; C_DIM=$'\e[2m'; C_RST=$'\e[0m'
else C_OK=""; C_WARN=""; C_ERR=""; C_DIM=""; C_RST=""; fi
report() { printf '  %-34s %s%s%s\n' "$1" "$3" "$2" "$C_RST"; }
ok()      { report "$1" "${2:-already OK}" "$C_OK"; }
changed() { report "$1" "$2" "$C_WARN"; }
fail()    { report "$1" "FAILED: $2" "$C_ERR"; }
die()     { echo "${C_ERR}error:${C_RST} $*" >&2; exit 1; }
info()    { echo "${C_DIM}$*${C_RST}"; }

load_env() {
    if [[ -f "$ROOT/.env" ]]; then
        set -a
        # shellcheck disable=SC1091
        source "$ROOT/.env"
        set +a
    fi
    SERVER_BIND="${PANIC_SERVER_BIND:-0.0.0.0:8121}"
    SERVER_PORT="${SERVER_BIND##*:}"
    WEB_PORT="${PANIC_WEB_PORT:-8120}"
    # Vite only answers to localhost unless told otherwise: always allow this machine's own names,
    # plus any extras from PANIC_WEB_ALLOWED_HOSTS, so access by hostname needs no per-host config.
    local h names=() extra="${PANIC_WEB_ALLOWED_HOSTS:-}"
    for h in "$(hostname -f 2>/dev/null)" "$(hostname -s 2>/dev/null)" ${extra//,/ }; do
        [[ -n "$h" && " ${names[*]} " != *" $h "* ]] && names+=("$h")
    done
    export PANIC_WEB_ALLOWED_HOSTS="$(IFS=,; echo "${names[*]}")"
    # AR-1.6: only quasar.config.ts (the dev proxy) reads this; the SPA itself never sees it.
    export PANIC_SERVER_URL="${PANIC_SERVER_URL:-http://127.0.0.1:$SERVER_PORT}"
}

with_node() { PATH="$NODE_HOME/bin:$PATH" "$@"; }

arch_triplet() {
    case "$(uname -m)" in
        x86_64) NODE_ARCH="linux-x64" ;;
        aarch64|arm64) NODE_ARCH="linux-arm64" ;;
        *) die "unsupported architecture $(uname -m)" ;;
    esac
}

ensure_venv() {
    mkdir -p "$PIDS" "$LOGS"
    if [[ ! -x "$VENV/bin/python" ]]; then
        uv venv "$VENV"
        uv pip install --python "$VENV/bin/python" -e "$ROOT/Application/Common" -e "$ROOT/Application/Server" >/dev/null 2>&1
        changed ".venv" "initialized"
    else
        ok ".venv"
    fi
    if [[ ! -f "$ROOT/.env" && -f "$ROOT/.env.example" ]]; then
        cp "$ROOT/.env.example" "$ROOT/.env"
        changed ".env" "created from .env.example"
    fi
}

#: pytest/ruff/mypy/import-linter (pyproject.toml [dependency-groups].dev) -- not needed to just
#: start/manage the server, so kept out of ensure_venv's fast path; `./panic test`/`setup` want it.
#: Hash-gated on uv.lock + pyproject.toml so repeat runs are a no-op.
ensure_dev_tools() {
    ensure_venv
    local step="dev tools (uv sync --group dev)"
    local marker="$VENV/.panic-dev-lock-hash"
    local now; now="$(sha256sum uv.lock pyproject.toml Application/*/pyproject.toml | sha256sum | awk '{print $1}')"
    if [[ -f "$marker" && "$(cat "$marker")" == "$now" ]]; then ok "$step"; return; fi
    uv sync --inexact --group dev >"$RUN/setup-uv-dev.log" 2>&1 || { cat "$RUN/setup-uv-dev.log" >&2; die "uv sync --group dev failed"; }
    echo "$now" > "$marker"
    changed "$step" "synced"
}

setup_node() {
    local step="Node $NODE_VERSION (.tools/node)"
    if [[ -x "$NODE_HOME/bin/node" ]] && [[ "$("$NODE_HOME/bin/node" --version)" == "$NODE_VERSION" ]]; then
        ok "$step"; return
    fi
    arch_triplet
    local state="installed"; [[ -x "$NODE_HOME/bin/node" ]] && state="updated"
    local tmp; tmp="$(mktemp -d)"
    local file="node-$NODE_VERSION-$NODE_ARCH.tar.gz"
    curl -fsSL "https://nodejs.org/dist/$NODE_VERSION/$file" -o "$tmp/$file"
    curl -fsSL "https://nodejs.org/dist/$NODE_VERSION/SHASUMS256.txt" -o "$tmp/SHASUMS256.txt"
    (cd "$tmp" && grep " $file\$" SHASUMS256.txt | sha256sum -c --quiet) || die "node checksum mismatch"
    rm -rf "$NODE_HOME"; mkdir -p "$NODE_HOME"
    tar -xzf "$tmp/$file" -C "$NODE_HOME" --strip-components=1
    rm -rf "$tmp"
    changed "$step" "$state"
}

setup_npm() {
    local step="npm ci (Application/Web)"
    [[ -f "$WEB_DIR/package.json" ]] || { ok "$step" "skipped (no package.json)"; return; }
    local marker="$WEB_DIR/node_modules/.panic-lock-hash"
    local now=""; [[ -f "$WEB_DIR/package-lock.json" ]] && now="$(sha256sum "$WEB_DIR/package-lock.json" | awk '{print $1}')"
    if [[ -n "$now" && -f "$marker" && "$(cat "$marker")" == "$now" ]]; then ok "$step"; return; fi
    local state="installed"; [[ -d "$WEB_DIR/node_modules" ]] && state="updated"
    mkdir -p "$RUN"
    if [[ -f "$WEB_DIR/package-lock.json" ]]; then
        (cd "$WEB_DIR" && with_node npm ci --no-audit --no-fund) >"$RUN/setup-npm.log" 2>&1 \
            || { tail -30 "$RUN/setup-npm.log" >&2; die "npm ci failed"; }
    else
        (cd "$WEB_DIR" && with_node npm install --no-audit --no-fund) >"$RUN/setup-npm.log" 2>&1 \
            || { tail -30 "$RUN/setup-npm.log" >&2; die "npm install failed"; }
        now="$(sha256sum "$WEB_DIR/package-lock.json" | awk '{print $1}')"
        state="installed (package-lock.json created)"
    fi
    echo "$now" > "$marker"
    changed "$step" "$state"
}

cmd_setup() {
    echo "Setting up PANIC workspace..."
    ensure_venv
    uv pip install --python "$VENV/bin/python" --no-deps -e "$ROOT/Application/Common" -e "$ROOT/Application/Server" >/dev/null 2>&1
    ok "editable packages" "panic-common, panic-server"
    ensure_dev_tools
    setup_node
    setup_npm
}

#: One dev-only MongoDB container, shared by ``start``/``test``/``load``. Never stopped
#: by this script so it survives across those runs; `docker compose ... down` to remove it.
DEV_MONGO_COMPOSE="$ROOT/Build/Containers/compose.dev-mongo.yaml"
DEV_MONGO_CONTAINER="panic-dev-mongo"
DEV_MONGO_PORT=27117

ensure_dev_mongo() {
    if ! docker ps --filter "name=^${DEV_MONGO_CONTAINER}\$" --filter "status=running" -q | grep -q .; then
        docker compose -f "$DEV_MONGO_COMPOSE" up -d >/dev/null 2>&1 \
            || die "could not start $DEV_MONGO_CONTAINER (is Docker running?)"
        changed "$DEV_MONGO_CONTAINER" "started"
    else
        ok "$DEV_MONGO_CONTAINER"
    fi
    local waited=0
    while ! docker exec "$DEV_MONGO_CONTAINER" mongosh --quiet --eval "db.runCommand('ping')" >/dev/null 2>&1; do
        waited=$((waited + 1))
        if [[ $waited -gt 30 ]]; then
            die "$DEV_MONGO_CONTAINER did not become ready on 127.0.0.1:$DEV_MONGO_PORT within 15s"
        fi
        sleep 0.5
    done
}

# ---------------------------------------------------------------- process management
pidfile() { echo "$PIDS/$1.pid"; }
is_running() {
    local f; f="$(pidfile "$1")"
    [[ -f "$f" ]] && kill -0 "$(cat "$f")" 2>/dev/null
}

expand_components() {
    local t="${1:-all}"
    if [[ "$t" == all ]]; then echo "${COMPONENTS[@]}"
    elif [[ " ${COMPONENTS[*]} " == *" $t "* ]]; then echo "$t"
    else die "unknown component '$t' (server|web|all)"; fi
}

start_one() {
    local c="$1" prod="$2"
    if is_running "$c"; then info "$c already running (pid $(cat "$(pidfile "$c")"))"; return; fi
    mkdir -p "$PIDS" "$LOGS"
    local log="$LOGS/$c.log"
    case "$c" in
        server)
            ensure_venv
            ensure_dev_mongo
            # No relational DATABASES (Mongo-backed store/sessions), so no `manage.py migrate` step:
            # instead ensure Mongo indexes and run data migrations (both idempotent).
            (cd "$SERVER_DIR" && "$VENV/bin/python" manage.py panic_ensure_indexes >"$log" 2>&1 \
                && "$VENV/bin/python" manage.py panic_migrate >>"$log" 2>&1) \
                || { tail -20 "$log" >&2; die "panic-server Mongo setup failed"; }
            if [[ "$prod" == 1 ]]; then
                (cd "$SERVER_DIR" && exec setsid "$VENV/bin/gunicorn" panic_server.wsgi:application \
                    --bind "$SERVER_BIND" --workers "${PANIC_SERVER_WORKERS:-4}" >>"$log" 2>&1) &
            else
                (cd "$SERVER_DIR" && exec setsid "$VENV/bin/python" manage.py runserver "$SERVER_BIND" --noreload >>"$log" 2>&1) &
            fi ;;
        web)
            [[ -x "$NODE_HOME/bin/node" ]] || die "node missing; run ./panic setup"
            [[ -d "$WEB_DIR/node_modules" ]] || die "web deps missing; run ./panic setup"
            (cd "$WEB_DIR" && PANIC_WEB_PORT="$WEB_PORT" PANIC_SERVER_URL="http://127.0.0.1:$SERVER_PORT" \
                exec setsid env PATH="$NODE_HOME/bin:$PATH" \
                "$WEB_DIR/node_modules/.bin/quasar" dev --port "$WEB_PORT" >>"$log" 2>&1) & ;;
        *) die "unknown component $c" ;;
    esac
    echo $! > "$(pidfile "$c")"
    case "$c" in server) echo "$SERVER_PORT" > "$PIDS/$c.port" ;; web) echo "$WEB_PORT" > "$PIDS/$c.port" ;; esac
    sleep 1
    if is_running "$c"; then echo "started $c (pid $(cat "$(pidfile "$c")"), log $log)"
    else rm -f "$(pidfile "$c")"; tail -20 "$log" >&2; die "$c failed to start"; fi
}

stop_one() {
    local c="$1" f; f="$(pidfile "$c")"
    if ! is_running "$c"; then rm -f "$f"; info "$c not running"; return; fi
    local pid; pid="$(cat "$f")"
    # setsid made the component a process-group leader: signal the whole group (quasar dev forks a vite child).
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 100); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
        echo "stopped $c (SIGKILL after 10s)"
    else
        echo "stopped $c"
    fi
    rm -f "$f" "$PIDS/$c.port"
}

http_status() { curl -s -o /dev/null -m 3 -w '%{http_code}' "$1" 2>/dev/null || true; }

status_one() {
    local c="$1" port="$2" state="stopped" pid="-" p="-" health="-"
    p="$port"
    if is_running "$c"; then
        state="running"; pid="$(cat "$(pidfile "$c")")"
        [[ -f "$PIDS/$c.port" ]] && p="$(cat "$PIDS/$c.port")"
        case "$c" in
            server) health="GET /api/v1/health -> $(http_status "http://127.0.0.1:$p/api/v1/health")" ;;
            web) health="GET / -> $(http_status "http://127.0.0.1:$p/")" ;;
        esac
    fi
    printf '%-8s %-8s %-8s %-6s %s\n' "$c" "$state" "$pid" "$p" "$health"
}

cmd_start() {
    local target="all" prod=0
    for a in "$@"; do case "$a" in --prod) prod=1 ;; *) target="$a" ;; esac; done
    load_env
    for c in $(expand_components "$target"); do start_one "$c" "$prod"; done
}

cmd_stop() {
    load_env
    local cs; cs="$(expand_components "${1:-all}")"
    for c in $(echo "$cs" | tr ' ' '\n' | tac); do stop_one "$c"; done
}

cmd_restart() { cmd_stop "${1:-all}"; cmd_start "$@"; }

cmd_status() {
    load_env
    printf '%-8s %-8s %-8s %-6s %s\n' COMPONENT STATE PID PORT HEALTH
    status_one server "$SERVER_PORT"
    status_one web "$WEB_PORT"
}

# ---------------------------------------------------------------- test / logs / misc
cmd_test() {
    load_env
    local mode="${1:-all}"
    shift || true
    export PYTHONPATH="$ROOT/Application/Common:$ROOT/Application/Server"
    local rc=0
    if [[ "$mode" == "python" || "$mode" == "lint" || "$mode" == "all" ]]; then
        ensure_dev_tools
    fi
    if [[ "$mode" == "python" || "$mode" == "all" ]]; then
        # CI supplies its own Mongo (Build/ci/mongo_service.sh); otherwise use the shared dev container.
        if [[ -z "${PANIC_TEST_MONGO_URI:-}" ]]; then
            ensure_dev_mongo
            export PANIC_TEST_MONGO_URI="mongodb://127.0.0.1:${DEV_MONGO_PORT}/"
        fi
        "$VENV/bin/pytest" "$ROOT/Application/Common/tests" "$ROOT/Application/Server/tests" \
            "$ROOT/Build/scripts/tests" "$@" || rc=1
    fi
    if [[ "$mode" == "lint" || "$mode" == "all" ]]; then
        "$VENV/bin/ruff" check "$ROOT/Application/Common" "$ROOT/Application/Server" || rc=1
        "$VENV/bin/mypy" "$ROOT/Application/Common/panic_common" "$ROOT/Application/Server/panic_server" || rc=1
        "$VENV/bin/lint-imports" || rc=1
    fi
    if [[ "$mode" == "web" || "$mode" == "all" ]]; then
        echo "== web"
        if [[ -d "$WEB_DIR/node_modules" ]]; then
            (cd "$WEB_DIR" && with_node npm run lint && with_node npm run typecheck && with_node npm test) || rc=1
        else
            echo "web deps missing (./panic setup)"
            rc=1
        fi
    fi
    return $rc
}

cmd_logs() {
    local c="${1:-server}"
    expand_components "$c" >/dev/null
    [[ -f "$LOGS/$c.log" ]] || die "no log yet for $c"
    tail -n 100 -f "$LOGS/$c.log"
}

#: ./panic contracts [--check]: regenerate (default) or, with --check, verify that
#: Documents/Architecture/openapi/server.yaml (drf-spectacular's AutoSchema walking
#: panic_server.api.urls) is up to date. Arguments come from a spectacular.args file;
#: there is no JSON-Schema-export step (no panic_common.schema_export). The web
#: API types (`src/api/generated/openapi.ts`) are regenerated separately with
#: `(cd Application/Web && npm run gen:api)` -- `npm run gen:api:check` is its own staleness check,
#: also enforced by test/unit/apiGenerated.spec.ts.
cmd_contracts() {
    load_env
    ensure_venv
    local spec="$ROOT/Documents/Architecture/openapi/server.yaml" args
    read -r -a args <"$ROOT/Documents/Architecture/openapi/spectacular.args"
    if [[ "${1:-}" == "--check" ]]; then
        local tmp
        tmp="$(mktemp)"
        (cd "$SERVER_DIR" && "$VENV/bin/python" manage.py spectacular "${args[@]}" --file "$tmp")
        if diff -q "$tmp" "$spec" >/dev/null 2>&1; then
            echo "contracts: $spec is up to date"
            rm -f "$tmp"
        else
            echo "contracts: $spec is STALE -- run './panic contracts' to regenerate" >&2
            diff -u "$spec" "$tmp" >&2 || true
            rm -f "$tmp"
            exit 1
        fi
        return
    fi
    (cd "$SERVER_DIR" && "$VENV/bin/python" manage.py spectacular "${args[@]}" --file "$spec")
    echo "wrote $spec"
}

case "${1:-help}" in
    setup)   cmd_setup ;;
    start)   shift; cmd_start "$@" ;;
    stop)    shift; cmd_stop "$@" ;;
    restart) shift; cmd_restart "$@" ;;
    status)  cmd_status ;;
    test)    shift; cmd_test "$@" ;;
    lint)    cmd_test lint ;;
    logs)    shift; cmd_logs "$@" ;;
    manage)  shift; ensure_venv; load_env; (cd "$SERVER_DIR" && "$VENV/bin/python" manage.py "$@") ;;
    addexamples|delexamples)
             ensure_venv; load_env
             (cd "$SERVER_DIR" && "$VENV/bin/python" manage.py panic_examples "$([[ $1 == addexamples ]] && echo add || echo remove)") ;;
    promote|demote)
             [[ $# -eq 2 ]] || die "usage: ./panic $1 <username>"
             ensure_venv; load_env; (cd "$SERVER_DIR" && "$VENV/bin/python" manage.py panic_user_admin "$1" "$2") ;;
    user)    shift
             [[ $# -eq 2 && ( "$1" == promote || "$1" == demote ) ]] || die "usage: ./panic user promote|demote <username>"
             ensure_venv; load_env; (cd "$SERVER_DIR" && "$VENV/bin/python" manage.py panic_user_admin "$1" "$2") ;;
    contracts) shift; cmd_contracts "$@" ;;
    *)       echo "Usage: ./panic {setup|start|stop|restart|status|test|lint|logs|manage|contracts|promote|demote|user|addexamples|delexamples}" ;;
esac
